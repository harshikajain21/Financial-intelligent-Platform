# Environment configuration template
# Copy to .env for local development

# LLM APIs
OPENAI_API_KEY=your_openai_api_key_here

# Financial Market Data APIs
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FINNHUB_API_KEY=your_finnhub_key_here
POLYGON_API_KEY=your_polygon_key_here
FRED_API_KEY=your_fred_key_here

# Security Keys
DEMO_API_KEY=demo_key_change_in_production
ADMIN_API_KEY=admin_key_change_in_production
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finplatform
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Platform Configuration
DEBUG=False
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://financial-intelligence-frontend.onrender.com"]

# Frontend API Endpoint
REACT_APP_API_URL=http://127.0.0.1:8000
